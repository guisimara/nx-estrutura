# URL oficial de produção, sem barra final. Usada para canonical, Open Graph, sitemap e robots.
# Nunca commitar um domínio de produção adivinhado — preencher apenas quando o domínio for confirmado.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Defina como "true" apenas no ambiente de produção oficial para permitir indexação.
# Mantenha "false" (ou ausente) em preview/staging para evitar indexação acidental.
NEXT_PUBLIC_ENABLE_INDEXING=false

# Dados institucionais — preencher apenas quando confirmados oficialmente pelo cliente.
NEXT_PUBLIC_LOGO_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_LINKEDIN=

# Tracking — preencher em etapa futura de Analytics e Tracking.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
